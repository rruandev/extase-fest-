# ============================================================================
# RR LOUNGE — variáveis de ambiente
# ============================================================================
# Copie para .env.local no desenvolvimento. Em produção, cadastre na Vercel
# (Project Settings -> Environment Variables) para Production e Preview.
#
# As quatro primeiras são OBRIGATÓRIAS pro fluxo de venda funcionar. Sem elas o
# site abre normalmente, mas a seção de ingressos não carrega os lotes.

# --- Estoque de lote em tempo real (Upstash Redis) -------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pagamento (Mercado Pago) ---------------------------------------------
# Access token de PRODUÇÃO. É com ele que o Pix é criado e conferido.
MP_ACCESS_TOKEN=

# --- Envio do ingresso por e-mail (Resend) --------------------------------
# O domínio do remetente (config/evento.ts -> CONTATO.emailRemetente) precisa
# estar verificado no Resend, senão o e-mail não é entregue.
RESEND_API_KEY=

# --- Verificador da portaria ----------------------------------------------
# Senha que o porteiro digita pra validar os QR Codes na entrada.
SENHA_PORTEIRO=

# --- Opcionais -------------------------------------------------------------
# Sobrescreve EVENTO.dataISO sem precisar de deploy. ISO 8601, fuso de Brasília.
EVENT_DATE=2026-09-12T22:00:00-03:00

# WhatsApp de suporte. Formato internacional, só dígitos: 55 + DDD + número.
WHATSAPP_NUMBER=

# Pixel da Meta. Vazio = pixel desligado. Precisa do prefixo NEXT_PUBLIC_
# porque é lido no navegador.
NEXT_PUBLIC_META_PIXEL_ID=
