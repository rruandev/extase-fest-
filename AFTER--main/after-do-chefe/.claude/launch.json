{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vercel Dev (static + API)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vercel", "dev", "--listen", "3000"],
      "port": 3000
    },
    {
      "name": "Static Preview (serve public/)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "public", "--listen", "5000", "--no-clipboard"],
      "port": 5000
    }
  ]
}
